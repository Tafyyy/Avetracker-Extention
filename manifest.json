{
  "manifest_version": 3,
  "name": "AVETRACKER",
  "version": "2.1",
  "description": "Расширение для чата твитч",
  "permissions": [
    "storage",
    "tabs",
    "offscreen",
    "identity"
  ],
  "host_permissions": [
    "https://*.music.yandex.ru/*",
    "https://music.yandex.ru/*",
    "https://*.twitch.tv/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.music.yandex.ru/*",
        "https://music.yandex.ru/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}